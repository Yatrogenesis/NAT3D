<?xml version='1.0' encoding='windows-1252'?>
<!--
  NAT3D Windows Installer — WiX 3 manifest
  Generated by cargo-wix, customized for NAT3D release.
  UpgradeCode is permanent — do NOT change across versions.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='NAT3D'
        UpgradeCode='1EB3E20F-BED0-4D42-8181-40DB807D658B'
        Manufacturer='Avermex Research Division'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='NAT3D — Next-generation Advanced Technology for 3D'
            Manufacturer='Avermex Research Division'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of NAT3D is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='NAT3D Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='NAT3D'>
                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='1CEBB8F3-4349-4392-A9E0-BE516A19D17F' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='nat3d-app.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\nat3d-app.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='NAT3D'>
                    <Component Id='ApplicationShortcut' Guid='A8F7C2E1-9B43-4D82-BC56-F12E3A7D9041'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                            Name='NAT3D'
                            Description='NAT3D — Next-generation Advanced Technology for 3D'
                            Target='[Bin]nat3d-app.exe'
                            WorkingDirectory='Bin'/>
                        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU'
                            Key='Software\Avermex\NAT3D'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs NAT3D and its components.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='ApplicationShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of NAT3D to the PATH system environment variable.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Property Id='ARPHELPLINK' Value='https://github.com/Yatrogenesis/NAT3D'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <!-- Skip EULA dialog — AGPL notice shown in About dialog instead -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
